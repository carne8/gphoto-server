<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Helpers.fs" />
    <Compile Include="libgphoto2\GPhoto2DllImports.fs" />
    <Compile Include="libgphoto2\Widgets.fs" />
    <Compile Include="libgphoto2\GPhoto2.fs" />
    <Compile Include="DTO.fs" />
    <Compile Include="Program.fs" />
    <Content Include=".gitignore" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Falco" Version="5.*" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.0.1" />
    <PackageReference Include="gphoto2_cl_binding" Version="0.1.3" />
    <PackageReference Include="libgphoto2" Version="0.3.2" />
  </ItemGroup>
</Project>